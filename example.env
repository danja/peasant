# Peasant configuration.
#
#   cp example.env .env     and fill in whichever keys you have.
#
# .env is gitignored; this file is not. Never put a real key in here.
#
# Nothing is required. Peasant uses whichever providers have a key, in the order
# given by PEASANT_PROVIDERS, and rotates to the next one when the current one
# runs out of budget or returns 429. One key is enough to start; more keys means
# fewer stalls, because the free tiers are metered independently.
#
# Every base URL below was probed on 2026-09-12 and responded as noted. They are
# defaults compiled into the provider profiles -- you only need to set one here
# to override it, so the *_BASE_URL lines stay commented out.


# --- Rotation -------------------------------------------------------------
#
# Providers are tried in the order below, and peasant MOVES ON TO THE NEXT ONE
# automatically whenever the current one is rate limited, out of budget,
# unavailable or failing. This is on by default and is most of the value of
# using free tiers: Groq allows 8,000 tokens a minute and Mistral 625,000, so
# the difference between stalling and not is usually just asking someone else.
#
# A provider that answers 401, 402 or 403 is dropped for the rest of the session
# rather than being asked again every turn. A provider that is merely rate
# limited is retried once its window rolls.
#
# Comma-separated. Providers without a key are skipped silently; a name that
# matches no profile is an error, not a warning.
#
# Mistral leads because it has 78x Groq's measured token headroom (625,000/min
# against 8,000/min), and a stall costs more than a few hundred milliseconds of
# latency does. Groq is dramatically faster per token, so flip these two if your
# turns are small and you would rather have speed than headroom.

PEASANT_PROVIDERS=mistral,groq,cerebras,openrouter,google,huggingface

# Turn rotation off to pin every request to the FIRST provider above and wait
# however long its budget takes to refill. Useful when comparing models, or when
# one provider's output is the only one you trust for a task.
#PEASANT_ROTATE=on

# How long to stall for a preferred provider before settling for a less
# preferred one that is free right now. Below this, wait; above it, rotate.
#PEASANT_MAX_WAIT_MS=5000

# How long to back off after a 429 that carries no retry-after -- which is most
# of them: Mistral's 429 has an empty body and no retry-after. A tight retry
# loop against a free tier is how an account earns a longer cooldown.
#PEASANT_BACKOFF_MS=20000


# --- Groq -----------------------------------------------------------------
# Free tier, no card. Fastest of the hosted options by a wide margin.
# Key:   https://console.groq.com/keys
# Probe: GET /openai/v1/models -> 401 without a key
#
# MEASURED 2026-09-12 from a real account: 8,000 tokens/minute, 1,000 requests.
# Every published summary says 6,000 tokens/minute -- they are wrong, which is
# exactly why peasant reads x-ratelimit-* response headers at runtime and treats
# any number written down as decoration. The tokens-per-minute ceiling is the
# binding constraint for a coding harness and is why ContextBudget exists.
# See docs/providers.md.

GROQ_API_KEY=
#GROQ_BASE_URL=https://api.groq.com/openai/v1


# --- Cerebras -------------------------------------------------------------
# Free tier, no card. Comparable speed to Groq, different model mix.
# Key:   https://cloud.cerebras.ai
# Probe: GET /v1/models -> 401 without a key

CEREBRAS_API_KEY=
#CEREBRAS_BASE_URL=https://api.cerebras.ai/v1


# --- Mistral --------------------------------------------------------------
# MEASURED 2026-09-12: 125 requests/minute and 625,000 tokens/minute -- 78x
# Groq's token headroom. It also reports what each query cost, in
# x-ratelimit-tokens-query-cost. It publishes no reset header, so the limiter has
# to infer the window. This is the provider to reach for when a turn is large.
# Its catalogue includes several models built for exactly this job:
# mistral-vibe-cli-with-tools, mistral-code-latest, codestral-latest.
# Key:   https://console.mistral.ai
# Probe: GET /v1/models -> 401 without a key

MISTRAL_API_KEY=
#MISTRAL_BASE_URL=https://api.mistral.ai/v1


# --- OpenRouter -----------------------------------------------------------
# One key, many models. 19 of the 445 models listed on 2026-09-12 carry the
# `:free` suffix. Documented free limits are 20 req/min and 50 req/day below $10
# of lifetime credit, rising to 1,000 req/day above it -- so it is a useful
# breadth-of-models fallback, not a workhorse.
# Key:   https://openrouter.ai/keys
# Probe: GET /api/v1/models -> 200 (the catalogue is public)
#
# OpenRouter attributes traffic by these two optional headers; they are sent only
# if set, and they affect nothing but its public leaderboards.

OPENROUTER_API_KEY=
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#OPENROUTER_SITE_URL=
#OPENROUTER_SITE_NAME=

# --- Google AI Studio -----------------------------------------------------
# Gemini through Google's OpenAI-compatible layer. Very large context windows on
# the Flash models, which matters more here than raw speed.
# Key:   https://aistudio.google.com/apikey
# Probe: GET /v1beta/openai/models -> 400 "Please pass a valid API key"
#        (400 rather than 401, but the Authorization: Bearer form is correct)
#
# Note the trailing path: the OpenAI shim lives under /v1beta/openai, not /v1.

GEMINI_API_KEY=
#GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai


# --- Hugging Face ---------------------------------------------------------
# The inference router, OpenAI-compatible, fronting many providers. A small
# monthly credit on the free account.
# Key:   https://huggingface.co/settings/tokens
# Probe: GET /v1/models -> 200

HF_TOKEN=
#HF_BASE_URL=https://router.huggingface.co/v1
#HF_MODEL=


# --- NVIDIA NIM -----------------------------------------------------------
# Free credits rather than a free tier, so it runs out. Worth having configured
# as a last resort.
# Key:   https://build.nvidia.com
# Probe: GET /v1/models -> 200

# Free credits rather than a free tier, so it runs out. Not tried unless named
# in PEASANT_PROVIDERS above.
NVIDIA_API_KEY=
#NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
#NVIDIA_MODEL=


# --- Together AI ----------------------------------------------------------
# A handful of free endpoints alongside the paid catalogue.
# Key:   https://api.together.xyz/settings/api-keys
# Probe: GET /v1/models -> 401 without a key

# A few free endpoints alongside a paid catalogue, so most of what it offers is
# not free. Not tried unless named in PEASANT_PROVIDERS above.
TOGETHER_API_KEY=
#TOGETHER_BASE_URL=https://api.together.xyz/v1
#TOGETHER_MODEL=


# --- Local models ---------------------------------------------------------
# No key, no quota, no network. Slow on an Athlon II, but it is the only option
# that cannot rate-limit you. Add `ollama` or `llamacpp` to PEASANT_PROVIDERS to
# use one; peasant does not start either, it only talks to one already running.

# Neither is tried unless you name it in PEASANT_PROVIDERS above -- probing a
# port nobody is listening on costs a connection refusal on every start.
# Neither needs a key; the *_API_KEY lines exist only for front-ends that want
# one. Plaintext is allowed here, and only here, because loopback never leaves
# the machine.

#OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
#OLLAMA_MODEL=
#OLLAMA_API_KEY=

#LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
#LLAMACPP_MODEL=
#LLAMACPP_API_KEY=


# --- Subscription logins (Claude Code, Codex) -----------------------------
#
# These two are not free tiers and not API keys. They reuse the OAuth token that
# Claude Code or the Codex CLI has already stored on this machine, so a
# subscription you pay for monthly answers peasant's requests instead of a
# metered key.
#
# READ THIS BEFORE ENABLING EITHER. Using a subscription credential from a
# third-party client is outside what Anthropic's and OpenAI's terms permit, and
# the token can be revoked. Neither is tried unless you name it in
# PEASANT_PROVIDERS above; that is deliberate, and it is not a default anyone
# should arrive at by accident.
#
# UNVERIFIED. Unlike every provider above, no response from either endpoint has
# been captured or inspected -- not the wire format, not the header names, not
# the shape of the credential file. See docs/danja-todo.md for what a first run
# has to confirm.
#
# Peasant READS those credential files and never writes them. Refreshing a token
# rotates it, and rotating another program's login from underneath it is how you
# lose both. When a token expires the provider is skipped with the remedy named:
# run `claude` or `codex` once and it refreshes its own file.
#
# Set the *_OAUTH_TOKEN lines only to override the file with a token of your own.

#CLAUDE_CODE_OAUTH_TOKEN=
#CLAUDE_CODE_BASE_URL=https://api.anthropic.com/v1
#CLAUDE_CODE_MODEL=

# CODEX_MODEL is REQUIRED, unlike every other provider here: that endpoint
# publishes no model catalogue, so there is nothing to choose from and peasant
# refuses to guess a name rather than ship a list that goes stale in silence.
#CODEX_OAUTH_TOKEN=
#CODEX_BASE_URL=https://chatgpt.com/backend-api/codex
#CODEX_MODEL=


# --- Any other OpenAI-compatible endpoint ---------------------------------
# The provider core is generic, so anything speaking /chat/completions works.
# Add `custom` to PEASANT_PROVIDERS and set all three.

#CUSTOM_BASE_URL=
#CUSTOM_API_KEY=
#CUSTOM_MODEL=


# --- Behaviour ------------------------------------------------------------
#
# Every tunable is defined once in src/config/preferences.js, with the reason
# for its value. A setting here that cannot be parsed is an error naming the
# variable, not a silent reversion to the default.

# Model per provider. Unset means the profile picks one from the catalogue, and
# refuses rather than guessing if nothing matches.
#GROQ_MODEL=
#CEREBRAS_MODEL=
#MISTRAL_MODEL=
#OPENROUTER_MODEL=
#GEMINI_MODEL=
#HF_MODEL=

# Fraction of the model's context window at which the conversation is compacted.
#PEASANT_COMPACT_AT=0.7

# How many times the agent may call a tool and look again before giving up.
# A model stuck in a loop would otherwise spend a day's quota in seconds.
#PEASANT_MAX_TURNS=25

# Messages kept verbatim at the end of a conversation when compacting.
#PEASANT_KEEP_RECENT=6

# Ceiling on a single response, in tokens. Not a rate limit and not a context
# window -- both of those are read from the provider, never written down. This
# is how much output peasant is willing to ask for in one turn, and the
# Anthropic Messages format requires it because it has no default of its own.
# Formats that do not require it are not sent it.
#PEASANT_MAX_OUTPUT_TOKENS=8000

# How many past sessions to keep in ~/.peasant/sessions. Older ones are removed
# when a new session starts.
#PEASANT_KEEP_SESSIONS=100

# Cap on a single tool result, in characters, before head/tail truncation.
# The default is deliberately small: at Groq's measured 8,000 tokens/min, one
# careless file read costs most of a minute.
#PEASANT_MAX_TOOL_RESULT=8000

# ask | allow | deny -- the default for tools that change something. (Phase 2.)
#PEASANT_PERMISSION_MODE=ask

# Where sessions are kept. (Phase 4.)
#PEASANT_HOME=~/.peasant


# --- Not supported --------------------------------------------------------
#
# GitHub Models was retired. Probed 2026-09-12: the old host
# models.inference.ai.azure.com no longer resolves, and models.github.ai returns
# 410 Gone. Do not add a profile for it.
